<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-1">Released Papers</h1>
    <p class="text-muted mb-0">Only papers released by the controller appear here. Download and print the approved PDF.</p>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Exam</th><th>Course</th><th>Set</th><th>Marks</th><th>Exam date</th><th>Released</th><th>By</th><th>Note</th><th></th></tr></thead>
      <tbody>
      <% released.forEach(function (p) { %>
        <tr>
          <td class="fw-semibold"><%= p.exam_name %></td>
          <td><%= p.course_code %> — <%= p.course_title %></td>
          <td><span class="badge text-bg-dark">Set <%= p.set_code %></span> v<%= p.version_no %></td>
          <td><%= Number(p.total_marks) %> / <%= Number(p.max_marks) %></td>
          <td class="text-nowrap"><%= String(p.exam_date).slice(0, 10) %></td>
          <td class="text-nowrap"><%= new Date(p.released_at).toISOString().slice(0, 16).replace('T', ' ') %></td>
          <td><%= p.released_by %></td>
          <td class="small"><%= p.note || '—' %></td>
          <td class="text-end"><a class="btn btn-sm btn-primary" href="/printing/papers/<%= p.id %>/download">Download PDF</a></td>
        </tr>
      <% }); %>
      <% if (!released.length) { %><tr><td colspan="9" class="text-center text-muted py-4">No papers have been released for printing yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/controller/scripts">Answer Scripts</a></li><li class="breadcrumb-item active"><%= script.student_code %></li></ol></nav>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= script.student_code %> — <%= script.student_name %></h1>
    <p class="text-muted mb-0"><%= script.exam_name %> &middot; <%= script.course_code %> &middot; <%= script.set_code ? 'Set ' + script.set_code : 'No set' %></p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/controller/scripts">Back</a>
    <a class="btn btn-primary" href="/controller/scripts/<%= script.id %>/download">Download PDF</a>
  </div>
</div>

<% if (script.hold_reason) { %>
  <div class="alert alert-warning"><span class="fw-semibold">On hold:</span> <%= script.hold_reason %></div>
<% } %>
<% if (!script.is_complete) { %>
  <div class="alert alert-danger">The uploaded file has <%= script.page_count %> page(s), but <%= script.expected_pages %> were expected. This script cannot be verified until corrected.</div>
<% } %>

<div class="row g-3 mb-3">
  <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Status</div><div class="fs-5"><span class="badge text-bg-info"><%= script.status.replaceAll('_', ' ') %></span></div></div></div></div>
  <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Pages</div><div class="fs-5"><%= script.page_count %><%= script.expected_pages ? ' / ' + script.expected_pages : '' %></div></div></div></div>
  <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Uploaded</div><div class="fs-5 small"><%= new Date(script.created_at).toISOString().slice(0, 16).replace('T', ' ') %></div></div></div></div>
  <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Verified</div><div class="fs-5 small"><%= script.verified_at ? new Date(script.verified_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></div></div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header fw-semibold">Script details</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Student</dt><dd class="col-sm-8"><%= script.student_name %> (<%= script.student_code %>)</dd>
          <dt class="col-sm-4">Examination</dt><dd class="col-sm-8"><%= script.exam_name %> — <%= String(script.exam_date).slice(0, 10) %></dd>
          <dt class="col-sm-4">Course</dt><dd class="col-sm-8"><%= script.course_code %> — <%= script.course_title %></dd>
          <dt class="col-sm-4">Paper set</dt><dd class="col-sm-8"><%= script.set_code ? 'Set ' + script.set_code : '—' %></dd>
          <dt class="col-sm-4">Original file</dt><dd class="col-sm-8"><%= script.original_name || '—' %></dd>
          <dt class="col-sm-4">SHA-256</dt><dd class="col-sm-8"><code class="small"><%= script.file_sha256 %></code></dd>
          <dt class="col-sm-4">Uploaded by</dt><dd class="col-sm-8"><%= script.uploaded_by_name %></dd>
          <dt class="col-sm-4">Verified by</dt><dd class="col-sm-8"><%= script.verified_by_name || '—' %></dd>
          <dt class="col-sm-4">Current evaluator</dt><dd class="col-sm-8"><%= script.faculty_name || 'Not allocated' %></dd>
          <dt class="col-sm-4">Evaluation</dt>
          <dd class="col-sm-8">
            <% if (script.evaluation_id) { %>
              <a href="/controller/marks/<%= script.evaluation_id %>"><%= script.evaluation_status.replaceAll('_', ' ') %><% if (script.evaluation_marks !== null) { %> — <%= Number(script.evaluation_marks) %> marks<% } %></a>
            <% } else { %>Not started<% } %>
          </dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header fw-semibold">Allocation history</div>
      <div class="table-responsive">
        <table class="table mb-0 align-middle">
          <thead><tr><th>When</th><th>Faculty</th><th>Allocated by</th><th>Reason</th><th>Current</th></tr></thead>
          <tbody>
          <% history.forEach(function (h) { %>
            <tr>
              <td class="text-nowrap"><%= new Date(h.allocated_at).toISOString().slice(0, 16).replace('T', ' ') %></td>
              <td><%= h.faculty_name %></td>
              <td><%= h.allocated_by_name %></td>
              <td class="small"><%= h.reason || '—' %></td>
              <td><%= h.is_current ? 'Yes' : 'No' %></td>
            </tr>
          <% }); %>
          <% if (!history.length) { %><tr><td colspan="5" class="text-center text-muted py-3">Not allocated yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <% const terminal = ['EVALUATED', 'MARKS_SUBMITTED'].includes(script.status); %>
    <div class="card mb-3">
      <div class="card-header fw-semibold">Verification</div>
      <div class="card-body">
        <% if (terminal) { %>
          <p class="text-muted mb-0">Marks have been submitted for this script; verification is closed.</p>
        <% } else { %>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <form method="post" action="/controller/scripts/<%= script.id %>/verify">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-success" type="submit" <%= script.is_complete ? '' : 'disabled' %>>Verify script</button>
            </form>
            <% if (script.status === 'ON_HOLD') { %>
              <form method="post" action="/controller/scripts/<%= script.id %>/release-hold">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-outline-success" type="submit" <%= script.is_complete ? '' : 'disabled' %>>Release hold</button>
              </form>
            <% } %>
          </div>
          <form method="post" action="/controller/scripts/<%= script.id %>/hold">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="form-label" for="reason">Put on hold</label>
            <div class="input-group">
              <input class="form-control" id="reason" name="reason" placeholder="Reason" maxlength="500" required>
              <button class="btn btn-outline-danger" type="submit">Hold</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header fw-semibold">Allocation</div>
      <div class="card-body">
        <% if (terminal) { %>
          <p class="text-muted mb-0">Reopen the marks before reallocating this script.</p>
        <% } else if (!faculty.length) { %>
          <div class="alert alert-warning mb-0">No active faculty are assigned to <%= script.course_code %>. Ask an administrator to assign one.</div>
        <% } else { %>
          <% if (script.status !== 'VERIFIED' && !script.faculty_name) { %>
            <p class="text-muted small">Verify the script before allocating it.</p>
          <% } %>
          <form method="post" action="/controller/scripts/<%= script.id %>/allocate">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-2">
              <label class="form-label" for="facultyId">Faculty evaluator</label>
              <select class="form-select" id="facultyId" name="facultyId" required>
                <option value="">Select faculty</option>
                <% faculty.forEach(function (f) { %>
                  <option value="<%= f.id %>" <%= String(script.faculty_id) === String(f.id) ? 'selected' : '' %>><%= f.full_name %></option>
                <% }); %>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label" for="allocReason"><%= script.faculty_name ? 'Reason for reallocating' : 'Note (optional)' %></label>
              <input class="form-control" id="allocReason" name="reason" maxlength="500" <%= script.faculty_name ? 'required' : '' %>>
            </div>
            <button class="btn btn-primary" type="submit" <%= (script.status === 'VERIFIED' || script.faculty_name) ? '' : 'disabled' %>><%= script.faculty_name ? 'Reallocate' : 'Allocate' %></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h1 class="h3 mb-1">Revaluation Requests</h1></div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Open a revaluation window</div>
  <div class="card-body">
    <form method="post" action="/revaluation/windows" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-3">
        <label class="form-label" for="examId">Exam</label>
        <select class="form-select" id="examId" name="examId" required>
          <option value="">Select exam</option>
          <% exams.forEach(function(e){ %><option value="<%= e.id %>"><%= e.name %> (#<%= e.id %>)</option><% }); %>
        </select>
      </div>
      <div class="col-md-3"><label class="form-label" for="opensAt">Opens</label><input class="form-control" id="opensAt" name="opensAt" type="datetime-local" required></div>
      <div class="col-md-3"><label class="form-label" for="closesAt">Closes</label><input class="form-control" id="closesAt" name="closesAt" type="datetime-local" required></div>
      <div class="col-md-2"><label class="form-label" for="feeAmount">Fee</label><input class="form-control" id="feeAmount" name="feeAmount" type="number" step="0.01" value="0"></div>
      <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Open</button></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header fw-semibold">Requests</div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Student</th><th>Exam</th><th>Status</th><th>Old</th><th>New</th><th>Reason</th><th>Action</th></tr></thead>
      <tbody>
      <% requests.forEach(function(r){ %>
        <tr>
          <td><%= r.student_code %> — <%= r.student_name %></td>
          <td><%= r.exam_name %></td>
          <td><%= r.status %></td>
          <td><%= r.old_marks !== null ? Number(r.old_marks) : '—' %></td>
          <td><%= r.new_marks !== null ? Number(r.new_marks) : '—' %></td>
          <td class="small"><%= r.reason %></td>
          <td>
            <form method="post" action="/revaluation/<%= r.id %>/review" class="d-flex gap-1">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select class="form-select form-select-sm" name="status" aria-label="Revaluation status">
                <option value="UNDER_REVIEW">Review</option>
                <option value="APPROVED">Approve</option>
                <option value="REJECTED">Reject</option>
                <option value="CLOSED">Close</option>
              </select>
              <input class="form-control form-control-sm" name="newMarks" placeholder="New marks" style="width:100px" aria-label="Revised marks">
              <input class="form-control form-control-sm" name="notes" placeholder="Notes" aria-label="Review notes">
              <button class="btn btn-sm btn-primary" type="submit">Save</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if(!requests.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No requests.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

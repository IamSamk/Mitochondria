<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Exam Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<% if (currentUser) { %>
<div class="d-flex app-shell">
  <nav class="sidebar p-3" aria-label="Main navigation">
    <div class="brand mb-4">Exam Management</div>
    <ul class="nav flex-column">
      <% nav.forEach(function (item) { %>
        <li class="nav-item"><a class="nav-link <%= (currentPath === item[1] || currentPath.startsWith(item[1] + '/')) ? 'active' : '' %>" href="<%= item[1] %>"><%= item[0] %></a></li>
      <% }) %>
    </ul>
  </nav>
  <div class="flex-grow-1">
    <header class="topbar d-flex justify-content-between align-items-center px-4 py-2">
      <span class="text-muted"><%= currentUser.fullName %> &middot; <span class="badge text-bg-secondary"><%= currentUser.role %></span></span>
      <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/account">My account</a>
        <form method="post" action="/logout" class="m-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-outline-secondary" type="submit">Log out</button>
        </form>
      </div>
    </header>
    <main class="p-4">
      <%- include('alerts') %>
<% } else { %>
<main class="container py-5">
  <%- include('alerts') %>
<% } %>

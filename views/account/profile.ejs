<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h3 mb-1">My account</h1>
    <p class="text-muted mb-0">Your profile details and sign-in security.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/dashboard">Back to dashboard</a>
</div>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header fw-semibold">Profile</div>
      <div class="card-body">
        <dl class="row mb-0 small">
          <dt class="col-5 text-muted fw-normal">Name</dt>
          <dd class="col-7"><%= profile.full_name %></dd>
          <dt class="col-5 text-muted fw-normal">Email</dt>
          <dd class="col-7 text-break"><%= profile.email %></dd>
          <dt class="col-5 text-muted fw-normal">Role</dt>
          <dd class="col-7"><span class="badge text-bg-secondary"><%= profile.role_code %></span></dd>
          <dt class="col-5 text-muted fw-normal">Department</dt>
          <dd class="col-7"><%= profile.department_name || '—' %></dd>
          <dt class="col-5 text-muted fw-normal">Last sign-in</dt>
          <dd class="col-7"><%= profile.last_login_at ? new Date(profile.last_login_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></dd>
          <dt class="col-5 text-muted fw-normal">Account created</dt>
          <dd class="col-7 mb-0"><%= new Date(profile.created_at).toISOString().slice(0, 10) %></dd>
        </dl>
        <p class="text-muted small mt-3 mb-0">To change your email, role or department, ask an administrator.</p>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header fw-semibold">Display name</div>
      <div class="card-body">
        <form method="post" action="/account/profile" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-sm-9">
            <label class="form-label" for="fullName">Full name</label>
            <input class="form-control" id="fullName" name="fullName" value="<%= profile.full_name %>" minlength="2" maxlength="120" required>
          </div>
          <div class="col-sm-3"><button class="btn btn-primary w-100" type="submit">Save name</button></div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header fw-semibold">Change password</div>
      <div class="card-body">
        <form method="post" action="/account/password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="currentPassword">Current password</label>
              <input class="form-control" id="currentPassword" name="currentPassword" type="password" maxlength="200" autocomplete="current-password" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="newPassword">New password</label>
              <input class="form-control" id="newPassword" name="newPassword" type="password" minlength="8" maxlength="200" autocomplete="new-password" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="confirmPassword">Confirm new password</label>
              <input class="form-control" id="confirmPassword" name="confirmPassword" type="password" minlength="8" maxlength="200" autocomplete="new-password" required>
            </div>
          </div>
          <div class="alert alert-warning mt-3 mb-0 small">
            At least 8 characters. Changing your password signs out every other active session.
          </div>
          <div class="mt-3"><button class="btn btn-primary" type="submit">Change password</button></div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

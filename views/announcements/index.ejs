<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h1 class="h3 mb-1">Announcements</h1></div>
</div>

<% if (['CONTROLLER','FACULTY','ADMIN','SUBJECT_HEAD','DEPARTMENT_HEAD'].includes(currentUser.role)) { %>
<div class="card mb-4">
  <div class="card-header fw-semibold">Post an announcement</div>
  <div class="card-body">
    <form method="post" action="/announcements">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-2"><label class="form-label" for="title">Title</label><input class="form-control" id="title" name="title" required maxlength="200"></div>
      <div class="mb-2"><label class="form-label" for="body">Body</label><textarea class="form-control" id="body" name="body" rows="3" required maxlength="5000"></textarea></div>
      <div class="row g-2">
        <div class="col-md-4"><label class="form-label" for="audienceRole">Audience role (optional)</label><input class="form-control" id="audienceRole" name="audienceRole" placeholder="STUDENT"></div>
      </div>
      <button class="btn btn-primary mt-3" type="submit">Post</button>
    </form>
  </div>
</div>
<% } %>

<div class="card">
  <div class="list-group list-group-flush">
  <% announcements.forEach(function(a){ %>
    <div class="list-group-item">
      <div class="d-flex justify-content-between">
        <span class="fw-semibold"><%= a.title %></span>
        <small class="text-muted"><%= new Date(a.created_at).toISOString().slice(0,16).replace('T',' ') %> by <%= a.author_name %></small>
      </div>
      <div class="small mt-1"><%= a.body %></div>
    </div>
  <% }); %>
  <% if(!announcements.length){ %><div class="list-group-item text-muted">No announcements yet.</div><% } %>
  </div>
</div>
<%- include('../partials/footer') %>

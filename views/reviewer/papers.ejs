<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-1">Papers to Review</h1>
    <p class="text-muted mb-0">Read submitted papers and approve them or send them back with comments.</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Review queue</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Exam</th><th>Course</th><th>Set</th><th>Marks</th><th>Submitted by</th><th>Submitted</th><th></th></tr></thead>
      <tbody>
      <% queue.forEach(function (p) { %>
        <tr>
          <td><div class="fw-semibold"><%= p.exam_name %></div><div class="small text-muted"><%= String(p.exam_date).slice(0, 10) %></div></td>
          <td><%= p.course_code %></td>
          <td><span class="badge text-bg-dark">Set <%= p.set_code %></span> v<%= p.version_no %></td>
          <td><%= Number(p.total_marks) %> / <%= Number(p.max_marks) %></td>
          <td><%= p.submitted_by %></td>
          <td class="text-nowrap"><%= p.submitted_at ? new Date(p.submitted_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></td>
          <td class="text-end"><a class="btn btn-sm btn-primary" href="/reviewer/papers/<%= p.id %>">Review</a></td>
        </tr>
      <% }); %>
      <% if (!queue.length) { %><tr><td colspan="7" class="text-center text-muted py-4">The review queue is empty.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header fw-semibold">My recent decisions</div>
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead><tr><th>When</th><th>Exam</th><th>Course</th><th>Set</th><th>Decision</th><th>Comments</th><th></th></tr></thead>
      <tbody>
      <% recent.forEach(function (r) { %>
        <tr>
          <td class="text-nowrap"><%= new Date(r.decided_at).toISOString().slice(0, 16).replace('T', ' ') %></td>
          <td><%= r.exam_name %></td>
          <td><%= r.course_code %></td>
          <td><%= r.set_code %> v<%= r.version_no %></td>
          <td><span class="badge text-bg-<%= r.decision === 'APPROVED' ? 'success' : 'danger' %>"><%= r.decision %></span></td>
          <td class="small"><%= r.comments || '—' %></td>
          <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/reviewer/papers/<%= r.version_id %>">Open</a></td>
        </tr>
      <% }); %>
      <% if (!recent.length) { %><tr><td colspan="7" class="text-center text-muted py-3">No decisions yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

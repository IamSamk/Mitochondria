<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h1 class="h3 mb-1">Exam Timetable Solver</h1><p class="text-muted mb-0">Greedy graph-colouring to avoid conflicting exams for shared students.</p></div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="post" action="/timetable/solve" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-6"><label class="form-label" for="examIds">Exam IDs (comma-separated)</label><input class="form-control" id="examIds" name="examIds" required></div>
      <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Solve</button></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h5 class="card-title">Create a slot</h5>
    <form method="post" action="/timetable/slots" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-2"><label class="form-label" for="examId">Exam ID</label><input class="form-control" id="examId" name="examId" type="number" required></div>
      <div class="col-md-3"><label class="form-label" for="slotStart">Start</label><input class="form-control" id="slotStart" name="slotStart" type="datetime-local" required></div>
      <div class="col-md-3"><label class="form-label" for="slotEnd">End</label><input class="form-control" id="slotEnd" name="slotEnd" type="datetime-local" required></div>
      <div class="col-md-2"><label class="form-label" for="venue">Venue</label><input class="form-control" id="venue" name="venue"></div>
      <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Add slot</button></div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>

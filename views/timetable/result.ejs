<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h1 class="h3 mb-1">Timetable Solution</h1></div>
  <a class="btn btn-outline-secondary" href="/timetable">Back</a>
</div>

<div class="alert alert-info">Minimum slots required: <strong><%= slots %></strong></div>

<div class="card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Exam</th><th>Name</th><th>Slot</th><th>Conflicts</th></tr></thead>
      <tbody>
      <% exams.forEach(function(e){ %>
        <tr>
          <td><%= e.id %></td>
          <td class="fw-semibold"><%= e.name %></td>
          <td>Slot <%= color[e.id] + 1 %></td>
          <td class="small"><%= Array.from(conflicts[e.id]||[]).join(', ') || '—' %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/faculty/papers">Question Papers</a></li><li class="breadcrumb-item"><a href="/faculty/papers/<%= version.paper_id %>"><%= version.exam_name %> — Set <%= version.set_code %></a></li><li class="breadcrumb-item active">v<%= version.version_no %> builder</li></ol></nav>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1">Set <%= version.set_code %> — version <%= version.version_no %></h1>
    <p class="text-muted mb-0"><%= version.course_code %> — <%= version.course_title %> &middot; <%= version.exam_name %></p>
  </div>
  <a class="btn btn-outline-secondary" href="/faculty/papers/<%= version.paper_id %>">Back to paper</a>
</div>

<% const total = Number(version.total_marks); const max = Number(version.max_marks); %>
<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <span class="fw-semibold">Paper total</span>
      <span class="<%= Math.abs(total - max) < 0.005 ? 'text-success' : 'text-warning' %> fw-semibold"><%= total %> / <%= max %> marks</span>
    </div>
    <% const pct = max > 0 ? Math.min(100, Math.round((total / max) * 100)) : 0; %>
    <div class="progress" role="progressbar" aria-valuenow="<%= total %>" aria-valuemin="0" aria-valuemax="<%= max %>" style="height: 12px">
      <div class="progress-bar <%= Math.abs(total - max) < 0.005 ? 'bg-success' : 'bg-warning' %>" style="width: <%= pct %>%"></div>
    </div>
    <div class="small text-muted mt-2">
      <% if (Math.abs(total - max) < 0.005) { %>The total matches the examination. You can submit for review.
      <% } else if (total > max) { %>The paper is over the maximum. Remove or replace questions.
      <% } else { %>Add <%= (max - total).toFixed(2) %> more marks before submitting.<% } %>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header fw-semibold">Questions in this version</div>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Section</th><th>No.</th><th>Question</th><th>Marks</th><th></th></tr></thead>
          <tbody>
          <% version.questions.forEach(function (q) { %>
            <tr>
              <td class="text-nowrap"><%= q.section_title %></td>
              <td><%= q.display_no %></td>
              <td>
                <%= q.body %>
                <% if (Array.isArray(q.options_json) && q.options_json.length) { %>
                  <div class="small text-muted mt-1">
                    <% q.options_json.forEach(function (o) { %><div><%= o.label %>. <%= o.body %></div><% }); %>
                  </div>
                <% } %>
              </td>
              <td><%= Number(q.marks) %></td>
              <td class="text-end">
                <form method="post" action="/faculty/papers/versions/<%= version.id %>/questions/<%= q.id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (!version.questions.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No questions yet. Add one from the bank.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <% if (version.questions.length) { %>
        <div class="card-footer d-flex justify-content-between align-items-center">
          <span class="text-muted small"><%= version.questions.length %> question(s)</span>
          <form method="post" action="/faculty/papers/versions/<%= version.id %>/submit">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-success" type="submit">Submit for review</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header fw-semibold">Add a question</div>
      <div class="card-body">
        <% if (availableQuestions.length) { %>
          <form method="post" action="/faculty/papers/versions/<%= version.id %>/questions">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label" for="sectionTitle">Section title</label>
              <input class="form-control" id="sectionTitle" name="sectionTitle" value="Section A" maxlength="80">
            </div>
            <div class="mb-3">
              <label class="form-label" for="questionId">Question from the bank</label>
              <select class="form-select" id="questionId" name="questionId" required size="10">
                <% availableQuestions.forEach(function (q) { %>
                  <option value="<%= q.id %>">[<%= q.question_type %> · <%= Number(q.marks) %>] <%= q.body.length > 110 ? q.body.slice(0, 110) + '…' : q.body %></option>
                <% }); %>
              </select>
              <div class="form-text">Only active questions from this course are shown.</div>
            </div>
            <button class="btn btn-primary" type="submit">Add to paper</button>
          </form>
        <% } else { %>
          <div class="alert alert-warning mb-0">No active questions exist for this course. <a href="/faculty/questions/new">Add questions to the bank</a> first.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/head/papers">Department Papers</a></li><li class="breadcrumb-item active"><%= paper.exam_name %> — Set <%= paper.set_code %></li></ol></nav>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= paper.exam_name %> — Set <%= paper.set_code %></h1>
    <p class="text-muted mb-0"><%= paper.course_code %> — <%= paper.course_title %> &middot; <%= String(paper.exam_date).slice(0, 10) %> &middot; teacher <%= paper.teacher_name %></p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/head/papers">Back</a>
    <% if (latest) { %><a class="btn btn-outline-primary" href="/papers/versions/<%= latest.id %>/download">Download PDF</a><% } %>
  </div>
</div>

<% if (latest) { %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Latest version — v<%= latest.version_no %></span>
      <div class="d-flex gap-2 align-items-center">
        <% const tone = { DRAFT: 'secondary', SUBMITTED: 'warning', UNDER_REVIEW: 'info', REJECTED: 'danger', APPROVED: 'success', RELEASED_FOR_PRINTING: 'primary' }[latest.status] || 'secondary'; %>
        <span class="badge text-bg-<%= tone %>"><%= latest.status.replaceAll('_', ' ') %></span>
        <% if (latest.is_finalized) { %><span class="badge text-bg-success">teacher finalized</span><% } %>
      </div>
    </div>
    <div class="card-body">
      <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="text-muted small">Total marks</div><div class="fs-5"><%= Number(latest.total_marks) %> / <%= Number(paper.max_marks) %></div></div>
        <div class="col-md-3"><div class="text-muted small">Questions</div><div class="fs-5"><%= latest.question_count %></div></div>
        <div class="col-md-3"><div class="text-muted small">Submitted</div><div class="fs-5 small"><%= latest.submitted_at ? new Date(latest.submitted_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></div></div>
        <div class="col-md-3"><div class="text-muted small">Approved</div><div class="fs-5 small"><%= latest.approved_at ? new Date(latest.approved_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></div></div>
      </div>

      <% if (latest.status === 'SUBMITTED') { %>
        <div class="alert alert-warning mb-0">This paper is waiting for your decision. Approve it to send it to the reviewer, or veto it with comments.</div>
      <% } else if (latest.status === 'UNDER_REVIEW') { %>
        <div class="alert alert-info mb-0">You approved this paper; it is now with the reviewer. You can still veto if something is wrong.</div>
      <% } else if (latest.status === 'APPROVED') { %>
        <div class="alert alert-success mb-0">Reviewer approved. Teacher finalization: <strong><%= latest.is_finalized ? 'done' : 'pending' %></strong>. You can still veto this paper.</div>
      <% } else if (latest.status === 'REJECTED') { %>
        <div class="alert alert-danger mb-0">This version is rejected. The teacher can revise and resubmit.</div>
      <% } else if (latest.status === 'RELEASED_FOR_PRINTING') { %>
        <div class="alert alert-primary mb-0">This paper has been released for printing.</div>
      <% } else { %>
        <div class="alert alert-secondary mb-0">This is still a teacher draft.</div>
      <% } %>

      <% if (questions.length) { %>
        <div class="table-responsive mt-3">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Section</th><th>No.</th><th>Question</th><th>Type</th><th class="text-end">Marks</th></tr></thead>
            <tbody>
            <% questions.forEach(function (q) { %>
              <tr>
                <td class="text-nowrap"><%= q.section_title %></td>
                <td class="text-nowrap"><%= q.display_no %></td>
                <td><%= q.body %><% if (Array.isArray(q.options_json) && q.options_json.length) { %><div class="small text-muted mt-1"><% q.options_json.forEach(function (o) { %><div><%= o.label %>. <%= o.body %></div><% }); %></div><% } %></td>
                <td><span class="badge text-bg-light border"><%= q.question_type %></span></td>
                <td class="text-end"><%= Number(q.marks) %></td>
              </tr>
            <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted mb-0 mt-3">No questions in this version yet.</p>
      <% } %>
    </div>
  </div>
<% } %>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header fw-semibold">Review trail</div>
      <div class="card-body">
        <% if (headReviews.length) { %>
          <div class="small text-muted mb-1">Subject head</div>
          <% headReviews.forEach(function (h) { %>
            <div class="border rounded p-2 mb-2">
              <div class="d-flex justify-content-between">
                <span class="badge text-bg-<%= h.decision === 'APPROVED' ? 'info' : 'danger' %>"><%= h.decision === 'APPROVED' ? 'HEAD APPROVED' : 'VETOED' %></span>
                <span class="text-muted small"><%= new Date(h.decided_at).toISOString().slice(0, 16).replace('T', ' ') %></span>
              </div>
              <div class="small mt-1">By <%= h.head_name %></div>
              <% if (h.comments) { %><div class="small mt-1"><%= h.comments %></div><% } %>
            </div>
          <% }); %>
        <% } %>
        <% if (approvals.length) { %>
          <div class="small text-muted mb-1">Reviewer</div>
          <% approvals.forEach(function (a) { %>
            <div class="border rounded p-2 mb-2">
              <div class="d-flex justify-content-between">
                <span class="badge text-bg-<%= a.decision === 'APPROVED' ? 'success' : 'danger' %>"><%= a.decision %></span>
                <span class="text-muted small"><%= new Date(a.decided_at).toISOString().slice(0, 16).replace('T', ' ') %></span>
              </div>
              <div class="small mt-1">By <%= a.reviewer_name %></div>
              <% if (a.comments) { %><div class="small mt-1"><%= a.comments %></div><% } %>
            </div>
          <% }); %>
        <% } %>
        <% if (!headReviews.length && !approvals.length) { %><p class="text-muted mb-0">No decisions recorded yet.</p><% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header fw-semibold"><%= isSubjectHead ? 'Your decision' : 'Head decision' %></div>
      <div class="card-body">
        <% if (latest && (canApprove || canVeto)) { %>
          <form method="post" action="/head/papers/<%= latest.id %>/head-review">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label" for="headComments">Comments</label>
              <textarea class="form-control" id="headComments" name="comments" rows="4" maxlength="5000"
                        placeholder="Required when vetoing; helpful when approving."></textarea>
            </div>
            <% if (canApprove) { %>
              <button class="btn btn-success w-100 mb-2" type="submit" name="decision" value="APPROVED">Approve into reviewer queue</button>
            <% } %>
            <% if (canVeto) { %>
              <button class="btn btn-outline-danger w-100" type="submit" name="decision" value="VETOED">Veto paper</button>
            <% } %>
          </form>
        <% } else { %>
          <p class="text-muted mb-0">
            <% if (!isSubjectHead) { %>
              Department-head supervision is read-only. The subject head records the approval or veto; you can still join the discussion below.
            <% } else { %>
              No head decision is available for this version.
            <% } %>
          </p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/paper-comments', {
  paperId: paper.id, comments: comments,
  returnTo: '/head/papers/' + paper.id,
  versionId: latest ? latest.id : null, questions: questions
}) %>
<%- include('../partials/paper-access', {
  paper: paper, downloadLock: downloadLock, downloadAttempts: downloadAttempts,
  canManageAccess: false, returnTo: '/head/papers/' + paper.id
}) %>
<%- include('../partials/footer') %>

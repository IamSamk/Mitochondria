<%- include('../partials/header') %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/head/logistics">Department Logistics</a></li><li class="breadcrumb-item active"><%= exam.name %></li></ol></nav>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= exam.name %></h1>
    <p class="text-muted mb-0"><%= exam.course_code %> — <%= exam.course_title %> &middot; <%= String(exam.exam_date).slice(0, 10) %> &middot; <%= exam.duration_minutes %> minutes</p>
  </div>
  <a class="btn btn-outline-secondary" href="/head/logistics">Back</a>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold">Seating arrangement</span>
    <span class="badge text-bg-secondary"><%= seating.length %> seat(s)</span>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Student</th><th>Name</th><th>Room</th><th>Seat</th></tr></thead>
      <tbody>
      <% seating.forEach(function (s) { %>
        <tr>
          <td class="fw-semibold"><%= s.student_code %></td>
          <td><%= s.student_name %></td>
          <td><%= s.room_name %></td>
          <td><%= s.seat_no %></td>
        </tr>
      <% }); %>
      <% if (!seating.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No seating generated yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold">Invigilation schedule</span>
    <span class="badge text-bg-secondary"><%= invigilations.length %> assignment(s)</span>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Room</th><th>Invigilator</th><th>Starts</th><th>Ends</th></tr></thead>
      <tbody>
      <% invigilations.forEach(function (i) { %>
        <tr>
          <td><%= i.room_name %></td>
          <td><%= i.invigilator_name %></td>
          <td class="small"><%= i.starts_at ? new Date(i.starts_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></td>
          <td class="small"><%= i.ends_at ? new Date(i.ends_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></td>
        </tr>
      <% }); %>
      <% if (!invigilations.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No invigilation generated yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

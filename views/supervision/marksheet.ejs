<%- include('../partials/header') %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/head/marksheets">Department Marksheets</a></li><li class="breadcrumb-item active"><%= exam.name %></li></ol></nav>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= exam.name %></h1>
    <p class="text-muted mb-0"><%= exam.course_code %> — <%= exam.course_title %> &middot; <%= String(exam.exam_date).slice(0, 10) %> &middot; out of <%= Number(exam.max_marks) %></p>
  </div>
  <a class="btn btn-outline-secondary" href="/head/marksheets">Back</a>
</div>

<div class="row g-3 mb-4">
  <% [['Students', counts.students], ['Marks entered', counts.entered], ['Pending', counts.pending], ['Average', counts.average]].forEach(function (c) { %>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small"><%= c[0] %></div><div class="display-6"><%= c[1] %></div></div></div></div>
  <% }); %>
</div>

<div class="card">
  <div class="card-header fw-semibold">Marks (read-only)</div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Student</th><th>Name</th><th>Marks</th><th>Last saved</th><th>By</th></tr></thead>
      <tbody>
      <% students.forEach(function (s) { %>
        <tr class="<%= s.is_active ? '' : 'table-light text-muted' %>">
          <td class="fw-semibold"><%= s.student_code %></td>
          <td><%= s.full_name %></td>
          <td><%= s.marks_obtained !== null && s.marks_obtained !== undefined ? Number(s.marks_obtained) + ' / ' + Number(exam.max_marks) : '—' %></td>
          <td class="small"><%= s.updated_at ? new Date(s.updated_at).toISOString().slice(0, 16).replace('T', ' ') : '—' %></td>
          <td class="small"><%= s.updated_by_name || '—' %></td>
        </tr>
      <% }); %>
      <% if (!students.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No students registered in this department.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

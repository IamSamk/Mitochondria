<%- include('../partials/header') %>
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li><li class="breadcrumb-item active">Password required</li></ol></nav>

<div class="card" style="max-width: 560px">
  <div class="card-header fw-semibold">Password-protected paper</div>
  <div class="card-body">
    <p class="mb-1"><strong><%= version.exam_name %> — Set <%= version.set_code %>, v<%= version.version_no %></strong></p>
    <p class="text-muted"><%= version.course_code %> — <%= version.course_title %></p>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form method="post" action="/papers/versions/<%= version.id %>/download">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3">
        <label class="form-label" for="password">Download password</label>
        <input class="form-control" id="password" name="password" type="password" required autofocus>
        <div class="form-text">The subject teacher set this password. Incorrect attempts are recorded and freeze downloads for 15 minutes.</div>
      </div>
      <button class="btn btn-primary" type="submit">Download paper</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>

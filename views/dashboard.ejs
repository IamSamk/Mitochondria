<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="h3 mb-1">Welcome, <%= currentUser.fullName %></h1>
    <p class="text-muted mb-0">Signed in as <span class="badge text-bg-secondary"><%= currentUser.role %></span></p>
  </div>
</div>

<% if (cards && cards.length) { %>
<div class="row g-3 mb-4">
  <% cards.forEach(function (card) { %>
    <div class="col-sm-6 col-xl-3">
      <a class="card h-100 text-decoration-none text-reset dashboard-card" href="<%= card.href %>">
        <div class="card-body">
          <div class="text-muted small"><%= card.label %></div>
          <div class="display-6"><%= card.value %></div>
          <% if (card.note) { %><div class="small text-muted"><%= card.note %></div><% } %>
        </div>
      </a>
    </div>
  <% }); %>
</div>
<% } %>

<% if (!tables || !tables.length) { %>
  <div class="alert alert-info">Nothing needs your attention right now.</div>
<% } %>

<% tables.forEach(function (table) { %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><%= table.title %></span>
      <% if (table.href) { %><a class="btn btn-sm btn-outline-secondary" href="<%= table.href %>">View all</a><% } %>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><% table.columns.forEach(function (col) { %><th><%= col %></th><% }); %></tr></thead>
        <tbody>
          <% table.rows.forEach(function (row) { %>
            <tr><% row.forEach(function (cell) { %><td><%= cell %></td><% }); %></tr>
          <% }); %>
          <% if (!table.rows.length) { %>
            <tr><td colspan="<%= table.columns.length %>" class="text-center text-muted py-4"><%= table.empty || 'Nothing here yet.' %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% }); %>

<%- include('partials/footer') %>

# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (hosted DBs like Neon/Supabase need SSL; it's enabled automatically for non-localhost URLs)
# For Supabase, prefer the "Session pooler" (port 5432) or direct connection for migrations;
# the transaction pooler (port 6543) may break prepared statements.
DATABASE_URL=postgres://emp:emp_dev_password@localhost:5432/emp
TEST_DATABASE_URL=postgres://emp:emp_dev_password@localhost:5432/emp_test

# Optional tuning
# DB_POOL_MAX=20
# SLOW_QUERY_MS=250

# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-another-long-random-string

# Protected storage (outside /public)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Vercel only: set SEED_DEMO_DATA=true to create the demo accounts during the build
# SEED_DEMO_DATA=true
# To inject a full demo dataset into a hosted DB (Supabase/Neon), run:
#   DATABASE_URL=<hosted url> NODE_ENV=production pnpm db:seed:demo
